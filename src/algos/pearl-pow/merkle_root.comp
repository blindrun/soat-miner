// rootCv: the last parent, with the ROOT flag. The twin of the kernel of the
// same name in src/algos/pearl-pow/prepare.cuh.
//
// One invocation. It exists as its own dispatch rather than as a branch inside
// merkle_reduce because the ROOT flag applies exactly once, at the top of the
// whole tree - not once per workgroup - and folding it into the reduction is
// how that distinction gets lost.

#version 450

#extension GL_GOOGLE_include_directive : require

#include "blake3.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly  buffer BufPair { uint pair[16]; };
layout(std430, binding = 1) readonly  buffer BufKey  { uint key[8]; };
layout(std430, binding = 2) writeonly buffer BufRoot { uint root[8]; };

void main() {
    uint k[8], l[8], r[8], p[8];
    for (uint j = 0u; j < 8u; j++) {
        k[j] = key[j];
        l[j] = pair[j];
        r[j] = pair[8u + j];
    }
    b3ParentCv(k, l, r, true, p);
    for (uint j = 0u; j < 8u; j++) root[j] = p[j];
}
