#version 450
// The Ethash DAG build, as a Vulkan compute shader. Shared by every ProgPoW
// coin in this repository.
//
// A second transcription of datasetItem512() in src/algos/progpow/ethash.h,
// which is the one source of truth shared by the host and CUDA. Two
// transcriptions of the same construction is a correctness risk, not a
// convenience, so tests/test_kawpow_vulkan.cpp builds the same items here and
// on the host and requires every word to match. That check is not ceremony:
// NVIDIA's Vulkan compiler once miscompiled the Autolykos kernel in this repo
// and the miner mined happily while every share was silently rejected.
//
// Why the DAG is spread over four buffers
// ---------------------------------------
// Measured, not assumed. Both target vendors report
// maxStorageBufferRange = 4294967295 - one byte under 4 GiB - and the RX
// 7900 XT additionally reports maxMemoryAllocationSize = 0xfffffffc. A
// Ravencoin DAG at epoch 600 is 6.11 GB, so it fits in neither one buffer nor
// one allocation, and no amount of shader cleverness changes that.
//
// So the host splits it, and every buffer length is a multiple of 64 words
// (256 bytes). That is what guarantees a 16-word item never straddles a
// boundary, which would otherwise be a corruption that only appears at one
// index in millions.
//
// Four bindings with a branch rather than a dynamically indexed descriptor
// array: non-uniform descriptor indexing needs the descriptor_indexing
// extension, and requiring it to avoid three comparisons would be a poor
// trade. Four buffers covers a 16 GiB DAG, which is past what any card here
// could hold anyway.
//
// The Keccak-f[1600] round body below is GENERATED by
// scripts/gen_keccak_round.py from the same ROTC/PILN tables the host uses.
// Hand-typing 24 rho/pi assignments is precisely how a shader ends up subtly
// wrong in a way that still produces plausible-looking digests. Regenerate and
// diff with:
//
//   python3 scripts/gen_keccak_round.py | diff - <(sed -n '/Theta/,/RC.r../p' src/algos/progpow/dag.comp)

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer Cache { uint w[]; } cache;
layout(std430, binding = 1) buffer Dag0 { uint w[]; } dag0;
layout(std430, binding = 2) buffer Dag1 { uint w[]; } dag1;
layout(std430, binding = 3) buffer Dag2 { uint w[]; } dag2;
layout(std430, binding = 4) buffer Dag3 { uint w[]; } dag3;

layout(push_constant) uniform PC {
    uint start;          // first 512-bit item this dispatch owns
    uint numItems512;    // total, so the tail dispatch can stop
    uint numCacheItems;  // 64-byte items in the light cache
    uint wordsPerBufShift;  // log2; a shift, not a divide
} pc;

const uint FNV_PRIME = 0x01000193u;

uint fnv1(uint u, uint v) { return (u * FNV_PRIME) ^ v; }

uint64_t rotl64(uint64_t x, int n) {
    return (x << n) | (x >> (64 - n));
}

const uint64_t RC[24] = uint64_t[24](
    0x0000000000000001UL, 0x0000000000008082UL, 0x800000000000808aUL,
    0x8000000080008000UL, 0x000000000000808bUL, 0x0000000080000001UL,
    0x8000000080008081UL, 0x8000000000008009UL, 0x000000000000008aUL,
    0x0000000000000088UL, 0x0000000080008009UL, 0x000000008000000aUL,
    0x000000008000808bUL, 0x800000000000008bUL, 0x8000000000008089UL,
    0x8000000000008003UL, 0x8000000000008002UL, 0x8000000000000080UL,
    0x000000000000800aUL, 0x800000008000000aUL, 0x8000000080008081UL,
    0x8000000000008080UL, 0x0000000080000001UL, 0x8000000080008008UL);

void keccakf(inout uint64_t a[25]) {
    uint64_t bc0, bc1, bc2, bc3, bc4, t;
    for (int r = 0; r < 24; r++) {
        // Theta
        bc0 = a[0] ^ a[5] ^ a[10] ^ a[15] ^ a[20];
        bc1 = a[1] ^ a[6] ^ a[11] ^ a[16] ^ a[21];
        bc2 = a[2] ^ a[7] ^ a[12] ^ a[17] ^ a[22];
        bc3 = a[3] ^ a[8] ^ a[13] ^ a[18] ^ a[23];
        bc4 = a[4] ^ a[9] ^ a[14] ^ a[19] ^ a[24];
        t = bc4 ^ rotl64(bc1, 1);
        a[0] ^= t;
        a[5] ^= t;
        a[10] ^= t;
        a[15] ^= t;
        a[20] ^= t;
        t = bc0 ^ rotl64(bc2, 1);
        a[1] ^= t;
        a[6] ^= t;
        a[11] ^= t;
        a[16] ^= t;
        a[21] ^= t;
        t = bc1 ^ rotl64(bc3, 1);
        a[2] ^= t;
        a[7] ^= t;
        a[12] ^= t;
        a[17] ^= t;
        a[22] ^= t;
        t = bc2 ^ rotl64(bc4, 1);
        a[3] ^= t;
        a[8] ^= t;
        a[13] ^= t;
        a[18] ^= t;
        a[23] ^= t;
        t = bc3 ^ rotl64(bc0, 1);
        a[4] ^= t;
        a[9] ^= t;
        a[14] ^= t;
        a[19] ^= t;
        a[24] ^= t;

        // Rho and Pi
        t = a[1];
        bc0 = a[10]; a[10] = rotl64(t, 1); t = bc0;
        bc0 = a[7]; a[7] = rotl64(t, 3); t = bc0;
        bc0 = a[11]; a[11] = rotl64(t, 6); t = bc0;
        bc0 = a[17]; a[17] = rotl64(t, 10); t = bc0;
        bc0 = a[18]; a[18] = rotl64(t, 15); t = bc0;
        bc0 = a[3]; a[3] = rotl64(t, 21); t = bc0;
        bc0 = a[5]; a[5] = rotl64(t, 28); t = bc0;
        bc0 = a[16]; a[16] = rotl64(t, 36); t = bc0;
        bc0 = a[8]; a[8] = rotl64(t, 45); t = bc0;
        bc0 = a[21]; a[21] = rotl64(t, 55); t = bc0;
        bc0 = a[24]; a[24] = rotl64(t, 2); t = bc0;
        bc0 = a[4]; a[4] = rotl64(t, 14); t = bc0;
        bc0 = a[15]; a[15] = rotl64(t, 27); t = bc0;
        bc0 = a[23]; a[23] = rotl64(t, 41); t = bc0;
        bc0 = a[19]; a[19] = rotl64(t, 56); t = bc0;
        bc0 = a[13]; a[13] = rotl64(t, 8); t = bc0;
        bc0 = a[12]; a[12] = rotl64(t, 25); t = bc0;
        bc0 = a[2]; a[2] = rotl64(t, 43); t = bc0;
        bc0 = a[20]; a[20] = rotl64(t, 62); t = bc0;
        bc0 = a[14]; a[14] = rotl64(t, 18); t = bc0;
        bc0 = a[22]; a[22] = rotl64(t, 39); t = bc0;
        bc0 = a[9]; a[9] = rotl64(t, 61); t = bc0;
        bc0 = a[6]; a[6] = rotl64(t, 20); t = bc0;
        bc0 = a[1]; a[1] = rotl64(t, 44); t = bc0;

        // Chi
        bc0 = a[0];
        bc1 = a[1];
        bc2 = a[2];
        bc3 = a[3];
        bc4 = a[4];
        a[0] ^= (~bc1) & bc2;
        a[1] ^= (~bc2) & bc3;
        a[2] ^= (~bc3) & bc4;
        a[3] ^= (~bc4) & bc0;
        a[4] ^= (~bc0) & bc1;
        bc0 = a[5];
        bc1 = a[6];
        bc2 = a[7];
        bc3 = a[8];
        bc4 = a[9];
        a[5] ^= (~bc1) & bc2;
        a[6] ^= (~bc2) & bc3;
        a[7] ^= (~bc3) & bc4;
        a[8] ^= (~bc4) & bc0;
        a[9] ^= (~bc0) & bc1;
        bc0 = a[10];
        bc1 = a[11];
        bc2 = a[12];
        bc3 = a[13];
        bc4 = a[14];
        a[10] ^= (~bc1) & bc2;
        a[11] ^= (~bc2) & bc3;
        a[12] ^= (~bc3) & bc4;
        a[13] ^= (~bc4) & bc0;
        a[14] ^= (~bc0) & bc1;
        bc0 = a[15];
        bc1 = a[16];
        bc2 = a[17];
        bc3 = a[18];
        bc4 = a[19];
        a[15] ^= (~bc1) & bc2;
        a[16] ^= (~bc2) & bc3;
        a[17] ^= (~bc3) & bc4;
        a[18] ^= (~bc4) & bc0;
        a[19] ^= (~bc0) & bc1;
        bc0 = a[20];
        bc1 = a[21];
        bc2 = a[22];
        bc3 = a[23];
        bc4 = a[24];
        a[20] ^= (~bc1) & bc2;
        a[21] ^= (~bc2) & bc3;
        a[22] ^= (~bc3) & bc4;
        a[23] ^= (~bc4) & bc0;
        a[24] ^= (~bc0) & bc1;

        // Iota
        a[0] ^= RC[r];
    }
}

/**
 * Keccak-512 of exactly 64 bytes, in place, ORIGINAL Keccak padding.
 *
 * Not SHA3. The padding byte is 0x01, and it lands in lane 8 together with the
 * rate terminator, giving 0x8000000000000001. Using SHA3's 0x06 here produces
 * a completely different DAG and every share is rejected.
 */
void keccak512_64(inout uint w[16]) {
    uint64_t a[25];
    for (int i = 0; i < 25; i++) a[i] = 0UL;
    for (int i = 0; i < 8; i++)
        a[i] = uint64_t(w[2 * i]) | (uint64_t(w[2 * i + 1]) << 32);
    a[8] = 0x8000000000000001UL;
    keccakf(a);
    for (int i = 0; i < 8; i++) {
        w[2 * i] = uint(a[i]);
        w[2 * i + 1] = uint(a[i] >> 32);
    }
}

void writeItem(uint item, uint w[16]) {
    const uint wordIndex = item * 16u;
    const uint buf = wordIndex >> pc.wordsPerBufShift;
    const uint idx = wordIndex & ((1u << pc.wordsPerBufShift) - 1u);
    // Branch rather than a descriptor array. The value is the same for every
    // invocation in a subgroup that is writing neighbouring items, so this is
    // very nearly free.
    if (buf == 0u)      { for (int i = 0; i < 16; i++) dag0.w[idx + i] = w[i]; }
    else if (buf == 1u) { for (int i = 0; i < 16; i++) dag1.w[idx + i] = w[i]; }
    else if (buf == 2u) { for (int i = 0; i < 16; i++) dag2.w[idx + i] = w[i]; }
    else                { for (int i = 0; i < 16; i++) dag3.w[idx + i] = w[i]; }
}

void main() {
    const uint item = pc.start + gl_GlobalInvocationID.x;
    if (item >= pc.numItems512) return;

    uint mix[16];
    const uint src = (item % pc.numCacheItems) * 16u;
    for (int i = 0; i < 16; i++) mix[i] = cache.w[src + i];
    mix[0] ^= item;
    keccak512_64(mix);

    // 512 FNV-1 passes over pseudo-random cache items.
    //
    // Written as 32 x 16 rather than one loop to 512 on purpose: the reference
    // reads mix[j % 16], and a dynamic index into a local array is the GLSL
    // trap that cost this repository a 75x slowdown in the Blake2b kernel.
    // Splitting the loop makes that index a constant the compiler can see,
    // which keeps the sixteen words in registers.
    for (uint jj = 0u; jj < 32u; jj++) {
        for (uint k = 0u; k < 16u; k++) {
            const uint j = jj * 16u + k;
            const uint t = fnv1(item ^ j, mix[k]);
            const uint parent = (t % pc.numCacheItems) * 16u;
            for (int i = 0; i < 16; i++)
                mix[i] = fnv1(mix[i], cache.w[parent + i]);
        }
    }

    keccak512_64(mix);
    writeItem(item, mix);
}
