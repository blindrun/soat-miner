shared uint l1[L1_WORDS];
shared uint xlane[1024];

uint rotl32(uint x, uint n) {
    n &= 31u;
    return n == 0u ? x : ((x << n) | (x >> (32u - n)));
}
uint rotr32(uint x, uint n) {
    n &= 31u;
    return n == 0u ? x : ((x >> n) | (x << (32u - n)));
}
uint fnv1a(uint u, uint v) { return (u ^ v) * FNV_PRIME; }
uint bswap32(uint x) {
    return ((x & 0x000000ffu) << 24) | ((x & 0x0000ff00u) << 8) |
           ((x & 0x00ff0000u) >> 8) | ((x & 0xff000000u) >> 24);
}

void keccakf800(inout uint a[25]) {
    uint bc0, bc1, bc2, bc3, bc4, t;
    for (int r = 0; r < 22; r++) {
        // Theta
        bc0 = a[0] ^ a[5] ^ a[10] ^ a[15] ^ a[20];
        bc1 = a[1] ^ a[6] ^ a[11] ^ a[16] ^ a[21];
        bc2 = a[2] ^ a[7] ^ a[12] ^ a[17] ^ a[22];
        bc3 = a[3] ^ a[8] ^ a[13] ^ a[18] ^ a[23];
        bc4 = a[4] ^ a[9] ^ a[14] ^ a[19] ^ a[24];
        t = bc4 ^ rotl32(bc1, 1);
        a[0] ^= t;
        a[5] ^= t;
        a[10] ^= t;
        a[15] ^= t;
        a[20] ^= t;
        t = bc0 ^ rotl32(bc2, 1);
        a[1] ^= t;
        a[6] ^= t;
        a[11] ^= t;
        a[16] ^= t;
        a[21] ^= t;
        t = bc1 ^ rotl32(bc3, 1);
        a[2] ^= t;
        a[7] ^= t;
        a[12] ^= t;
        a[17] ^= t;
        a[22] ^= t;
        t = bc2 ^ rotl32(bc4, 1);
        a[3] ^= t;
        a[8] ^= t;
        a[13] ^= t;
        a[18] ^= t;
        a[23] ^= t;
        t = bc3 ^ rotl32(bc0, 1);
        a[4] ^= t;
        a[9] ^= t;
        a[14] ^= t;
        a[19] ^= t;
        a[24] ^= t;

        // Rho and Pi
        t = a[1];
        bc0 = a[10];
        a[10] = rotl32(t, 1);
        t = bc0;
        bc0 = a[7];
        a[7] = rotl32(t, 3);
        t = bc0;
        bc0 = a[11];
        a[11] = rotl32(t, 6);
        t = bc0;
        bc0 = a[17];
        a[17] = rotl32(t, 10);
        t = bc0;
        bc0 = a[18];
        a[18] = rotl32(t, 15);
        t = bc0;
        bc0 = a[3];
        a[3] = rotl32(t, 21);
        t = bc0;
        bc0 = a[5];
        a[5] = rotl32(t, 28);
        t = bc0;
        bc0 = a[16];
        a[16] = rotl32(t, 4);
        t = bc0;
        bc0 = a[8];
        a[8] = rotl32(t, 13);
        t = bc0;
        bc0 = a[21];
        a[21] = rotl32(t, 23);
        t = bc0;
        bc0 = a[24];
        a[24] = rotl32(t, 2);
        t = bc0;
        bc0 = a[4];
        a[4] = rotl32(t, 14);
        t = bc0;
        bc0 = a[15];
        a[15] = rotl32(t, 27);
        t = bc0;
        bc0 = a[23];
        a[23] = rotl32(t, 9);
        t = bc0;
        bc0 = a[19];
        a[19] = rotl32(t, 24);
        t = bc0;
        bc0 = a[13];
        a[13] = rotl32(t, 8);
        t = bc0;
        bc0 = a[12];
        a[12] = rotl32(t, 25);
        t = bc0;
        bc0 = a[2];
        a[2] = rotl32(t, 11);
        t = bc0;
        bc0 = a[20];
        a[20] = rotl32(t, 30);
        t = bc0;
        bc0 = a[14];
        a[14] = rotl32(t, 18);
        t = bc0;
        bc0 = a[22];
        a[22] = rotl32(t, 7);
        t = bc0;
        bc0 = a[9];
        a[9] = rotl32(t, 29);
        t = bc0;
        bc0 = a[6];
        a[6] = rotl32(t, 20);
        t = bc0;
        bc0 = a[1];
        a[1] = rotl32(t, 12);
        t = bc0;

        // Chi
        bc0 = a[0];
        bc1 = a[1];
        bc2 = a[2];
        bc3 = a[3];
        bc4 = a[4];
        a[0] = bc0 ^ ((~bc1) & bc2);
        a[1] = bc1 ^ ((~bc2) & bc3);
        a[2] = bc2 ^ ((~bc3) & bc4);
        a[3] = bc3 ^ ((~bc4) & bc0);
        a[4] = bc4 ^ ((~bc0) & bc1);
        bc0 = a[5];
        bc1 = a[6];
        bc2 = a[7];
        bc3 = a[8];
        bc4 = a[9];
        a[5] = bc0 ^ ((~bc1) & bc2);
        a[6] = bc1 ^ ((~bc2) & bc3);
        a[7] = bc2 ^ ((~bc3) & bc4);
        a[8] = bc3 ^ ((~bc4) & bc0);
        a[9] = bc4 ^ ((~bc0) & bc1);
        bc0 = a[10];
        bc1 = a[11];
        bc2 = a[12];
        bc3 = a[13];
        bc4 = a[14];
        a[10] = bc0 ^ ((~bc1) & bc2);
        a[11] = bc1 ^ ((~bc2) & bc3);
        a[12] = bc2 ^ ((~bc3) & bc4);
        a[13] = bc3 ^ ((~bc4) & bc0);
        a[14] = bc4 ^ ((~bc0) & bc1);
        bc0 = a[15];
        bc1 = a[16];
        bc2 = a[17];
        bc3 = a[18];
        bc4 = a[19];
        a[15] = bc0 ^ ((~bc1) & bc2);
        a[16] = bc1 ^ ((~bc2) & bc3);
        a[17] = bc2 ^ ((~bc3) & bc4);
        a[18] = bc3 ^ ((~bc4) & bc0);
        a[19] = bc4 ^ ((~bc0) & bc1);
        bc0 = a[20];
        bc1 = a[21];
        bc2 = a[22];
        bc3 = a[23];
        bc4 = a[24];
        a[20] = bc0 ^ ((~bc1) & bc2);
        a[21] = bc1 ^ ((~bc2) & bc3);
        a[22] = bc2 ^ ((~bc3) & bc4);
        a[23] = bc3 ^ ((~bc4) & bc0);
        a[24] = bc4 ^ ((~bc0) & bc1);

        // Iota
        a[0] ^= RC800[r];
    }
}

/** KISS99. A single wrong constant changes every hash. */
struct Kiss { uint z, w, jsr, jcong; };

uint kissNext(inout Kiss k) {
    k.z = 36969u * (k.z & 0xffffu) + (k.z >> 16);
    k.w = 18000u * (k.w & 0xffffu) + (k.w >> 16);
    k.jcong = 69069u * k.jcong + 1234567u;
    k.jsr ^= (k.jsr << 17);
    k.jsr ^= (k.jsr >> 13);
    k.jsr ^= (k.jsr << 5);
    return (((k.z << 16) + k.w) ^ k.jcong) + k.jsr;
}

/** ProgPoW 0.9.4's eleven operations. KawPow uses this labelling; 0.9.2
 *  rotates it, which is handled on the host and does not reach this shader. */
uint randomMath(uint a, uint b, uint sel) {
    switch (sel % 11u) {
        case 0u: return a + b;
        case 1u: return a * b;
        case 2u: return uint((uint64_t(a) * uint64_t(b)) >> 32);
        case 3u: return min(a, b);
        case 4u: return rotl32(a, b);
        case 5u: return rotr32(a, b);
        case 6u: return a & b;
        case 7u: return a | b;
        case 8u: return a ^ b;
        case 9u: return uint(findMSB(a) < 0 ? 32 : 31 - findMSB(a)) +
                        uint(findMSB(b) < 0 ? 32 : 31 - findMSB(b));
        default: return uint(bitCount(a)) + uint(bitCount(b));
    }
}

/** Only operations that keep a's entropy when b has little - hence no a & b. */
void randomMerge(inout uint a, uint b, uint sel) {
    const uint x = (sel >> 16) % 31u + 1u;
    switch (sel % 4u) {
        case 0u: a = (a * 33u) + b; break;
        case 1u: a = (a ^ b) * 33u; break;
        case 2u: a = rotl32(a, x) ^ b; break;
        default: a = rotr32(a, x) ^ b; break;
    }
}

/**
 * One word out of the split DAG.
 *
 * The buffer count is a power of two words on purpose. A divide by a runtime
 * value here was the actual cost of this shader: four words per lane per
 * round, sixty-four rounds, sixteen lanes is 4096 integer divisions per hash,
 * and a GPU has no integer divide. Measured, it held the whole shader at 1.67
 * MH/s while neither specialisation constants nor removing the per-round
 * barriers moved it at all.
 */
uint dagWord(uint wordIndex) {
    const uint buf = wordIndex >> pc.wordsPerBufShift;
    const uint idx = wordIndex & ((1u << pc.wordsPerBufShift) - 1u);
    if (buf == 0u) return dag0.w[idx];
    if (buf == 1u) return dag1.w[idx];
    if (buf == 2u) return dag2.w[idx];
    if (buf == 3u) return dag3.w[idx];
    if (buf == 4u) return dag4.w[idx];
    if (buf == 5u) return dag5.w[idx];
    if (buf == 6u) return dag6.w[idx];
    return dag7.w[idx];
}

/** The four words a lane reads in a round are contiguous and, because every
 *  buffer is a multiple of 64 words, always in the same buffer - so the
 *  selection is done once rather than four times. */
void dagQuad(uint wordIndex, out uint d[4]) {
    const uint buf = wordIndex >> pc.wordsPerBufShift;
    const uint idx = wordIndex & ((1u << pc.wordsPerBufShift) - 1u);
    if (buf == 0u) { d[0] = dag0.w[idx]; d[1] = dag0.w[idx + 1u]; d[2] = dag0.w[idx + 2u]; d[3] = dag0.w[idx + 3u]; }
    else if (buf == 1u) { d[0] = dag1.w[idx]; d[1] = dag1.w[idx + 1u]; d[2] = dag1.w[idx + 2u]; d[3] = dag1.w[idx + 3u]; }
    else if (buf == 2u) { d[0] = dag2.w[idx]; d[1] = dag2.w[idx + 1u]; d[2] = dag2.w[idx + 2u]; d[3] = dag2.w[idx + 3u]; }
    else if (buf == 3u) { d[0] = dag3.w[idx]; d[1] = dag3.w[idx + 1u]; d[2] = dag3.w[idx + 2u]; d[3] = dag3.w[idx + 3u]; }
    else if (buf == 4u) { d[0] = dag4.w[idx]; d[1] = dag4.w[idx + 1u]; d[2] = dag4.w[idx + 2u]; d[3] = dag4.w[idx + 3u]; }
    else if (buf == 5u) { d[0] = dag5.w[idx]; d[1] = dag5.w[idx + 1u]; d[2] = dag5.w[idx + 2u]; d[3] = dag5.w[idx + 3u]; }
    else if (buf == 6u) { d[0] = dag6.w[idx]; d[1] = dag6.w[idx + 1u]; d[2] = dag6.w[idx + 2u]; d[3] = dag6.w[idx + 3u]; }
    else                { d[0] = dag7.w[idx]; d[1] = dag7.w[idx + 1u]; d[2] = dag7.w[idx + 2u]; d[3] = dag7.w[idx + 3u]; }
}

void main() {
    const uint lane = gl_LocalInvocationID.x % 16u;
    const uint group = gl_LocalInvocationID.x / 16u;
    const uint groups = gl_WorkGroupSize.x / 16u;

    // The L1 cache is the first 16 KB of the DAG, copied in once per workgroup.
    for (uint i = gl_LocalInvocationID.x; i < L1_WORDS; i += gl_WorkGroupSize.x)
        l1[i] = dagWord(i);
    barrier();

    const uint64_t base = uint64_t(pc.baseLo) | (uint64_t(pc.baseHi) << 32);
    const uint64_t count = uint64_t(pc.countLo) | (uint64_t(pc.countHi) << 32);
    const uint64_t index =
        uint64_t(gl_WorkGroupID.x) * uint64_t(groups) + uint64_t(group);
    // Out-of-range invocations stay in the workgroup so every barrier below is
    // reached by everyone. Returning here would be undefined behaviour.
    const bool inRange = index < count;
    const uint64_t nonce = base + (inRange ? index : 0UL);

    uint st[25];
    for (int i = 0; i < 8; i++) st[i] = pc.h[i];
    st[8] = uint(nonce);
    st[9] = uint(nonce >> 32);
    for (int i = 10; i < 25; i++) st[i] = RAVEN[i - 10];
    keccakf800(st);
    uint state2[8];
    for (int i = 0; i < 8; i++) state2[i] = st[i];

    const uint z = fnv1a(FNV_OFFSET, state2[0]);
    const uint w = fnv1a(z, state2[1]);
    Kiss rng = Kiss(z, w, fnv1a(w, lane), fnv1a(fnv1a(w, lane), lane));
    uint mix[32];
    for (int i = 0; i < 32; i++) mix[i] = kissNext(rng);

    for (uint r = 0u; r < 64u; r++) {
        // Lane (r % 16)'s register zero, through shared memory.
        //
        // A subgroup shuffle does this without the two barriers and was tried:
        // it measured 1.67 MH/s against 1.67. It is not kept, because it would
        // add a GL_KHR_shader_subgroup_shuffle requirement to every device for
        // no measured gain, and an unused requirement is a device this miner
        // refuses to run on for nothing.
        xlane[gl_LocalInvocationID.x] = mix[0];
        barrier();
        const uint seedReg = xlane[group * 16u + (r % 16u)];
        barrier();

        const uint item = seedReg % pc.numItems2048;
        const uint chunk = (lane ^ r) % 16u;
        const uint dbase = item * 64u + chunk * 4u;
        uint d[4];
        dagQuad(dbase, d);

        // One round, straight-line. A loop here would put the
        // destination index back at runtime and undo the point.
        { const uint o = mix[CSRC0] % L1_WORDS;
          randomMerge(mix[CDST0], l1[o], CSEL0); }
        { const uint t = randomMath(mix[MSRC10], mix[MSRC20], MSEL10);
          randomMerge(mix[MDST0], t, MSEL20); }
        { const uint o = mix[CSRC1] % L1_WORDS;
          randomMerge(mix[CDST1], l1[o], CSEL1); }
        { const uint t = randomMath(mix[MSRC11], mix[MSRC21], MSEL11);
          randomMerge(mix[MDST1], t, MSEL21); }
        { const uint o = mix[CSRC2] % L1_WORDS;
          randomMerge(mix[CDST2], l1[o], CSEL2); }
        { const uint t = randomMath(mix[MSRC12], mix[MSRC22], MSEL12);
          randomMerge(mix[MDST2], t, MSEL22); }
        { const uint o = mix[CSRC3] % L1_WORDS;
          randomMerge(mix[CDST3], l1[o], CSEL3); }
        { const uint t = randomMath(mix[MSRC13], mix[MSRC23], MSEL13);
          randomMerge(mix[MDST3], t, MSEL23); }
        { const uint o = mix[CSRC4] % L1_WORDS;
          randomMerge(mix[CDST4], l1[o], CSEL4); }
        { const uint t = randomMath(mix[MSRC14], mix[MSRC24], MSEL14);
          randomMerge(mix[MDST4], t, MSEL24); }
        { const uint o = mix[CSRC5] % L1_WORDS;
          randomMerge(mix[CDST5], l1[o], CSEL5); }
        { const uint t = randomMath(mix[MSRC15], mix[MSRC25], MSEL15);
          randomMerge(mix[MDST5], t, MSEL25); }
        { const uint o = mix[CSRC6] % L1_WORDS;
          randomMerge(mix[CDST6], l1[o], CSEL6); }
        { const uint t = randomMath(mix[MSRC16], mix[MSRC26], MSEL16);
          randomMerge(mix[MDST6], t, MSEL26); }
        { const uint o = mix[CSRC7] % L1_WORDS;
          randomMerge(mix[CDST7], l1[o], CSEL7); }
        { const uint t = randomMath(mix[MSRC17], mix[MSRC27], MSEL17);
          randomMerge(mix[MDST7], t, MSEL27); }
        { const uint o = mix[CSRC8] % L1_WORDS;
          randomMerge(mix[CDST8], l1[o], CSEL8); }
        { const uint t = randomMath(mix[MSRC18], mix[MSRC28], MSEL18);
          randomMerge(mix[MDST8], t, MSEL28); }
        { const uint o = mix[CSRC9] % L1_WORDS;
          randomMerge(mix[CDST9], l1[o], CSEL9); }
        { const uint t = randomMath(mix[MSRC19], mix[MSRC29], MSEL19);
          randomMerge(mix[MDST9], t, MSEL29); }
        { const uint o = mix[CSRC10] % L1_WORDS;
          randomMerge(mix[CDST10], l1[o], CSEL10); }
        { const uint t = randomMath(mix[MSRC110], mix[MSRC210], MSEL110);
          randomMerge(mix[MDST10], t, MSEL210); }
        { const uint t = randomMath(mix[MSRC111], mix[MSRC211], MSEL111);
          randomMerge(mix[MDST11], t, MSEL211); }
        { const uint t = randomMath(mix[MSRC112], mix[MSRC212], MSEL112);
          randomMerge(mix[MDST12], t, MSEL212); }
        { const uint t = randomMath(mix[MSRC113], mix[MSRC213], MSEL113);
          randomMerge(mix[MDST13], t, MSEL213); }
        { const uint t = randomMath(mix[MSRC114], mix[MSRC214], MSEL114);
          randomMerge(mix[MDST14], t, MSEL214); }
        { const uint t = randomMath(mix[MSRC115], mix[MSRC215], MSEL115);
          randomMerge(mix[MDST15], t, MSEL215); }
        { const uint t = randomMath(mix[MSRC116], mix[MSRC216], MSEL116);
          randomMerge(mix[MDST16], t, MSEL216); }
        { const uint t = randomMath(mix[MSRC117], mix[MSRC217], MSEL117);
          randomMerge(mix[MDST17], t, MSEL217); }
        randomMerge(mix[DDST0], d[0], DSEL0);
        randomMerge(mix[DDST1], d[1], DSEL1);
        randomMerge(mix[DDST2], d[2], DSEL2);
        randomMerge(mix[DDST3], d[3], DSEL3);
    }

    uint lh = FNV_OFFSET;
    for (int i = 0; i < 32; i++) lh = fnv1a(lh, mix[i]);
    xlane[gl_LocalInvocationID.x] = lh;
    barrier();

    if (lane != 0u || !inRange) return;

    uint mixHash[8];
    for (int i = 0; i < 8; i++) mixHash[i] = FNV_OFFSET;
    for (uint l = 0u; l < 16u; l++)
        mixHash[l % 8u] = fnv1a(mixHash[l % 8u], xlane[group * 16u + l]);

    uint fs[25];
    for (int i = 0; i < 8; i++) fs[i] = state2[i];
    for (int i = 0; i < 8; i++) fs[8 + i] = mixHash[i];
    for (int i = 16; i < 25; i++) fs[i] = RAVEN[i - 16];
    keccakf800(fs);

    // The digest is a BIG-endian 256-bit integer: byte 0 is most significant.
    uint64_t hit[4];
    for (int k = 0; k < 4; k++)
        hit[3 - k] = (uint64_t(bswap32(fs[2 * k])) << 32) |
                     uint64_t(bswap32(fs[2 * k + 1]));

    bool under = true;
    for (int i = 3; i >= 0; i--) {
        const uint64_t tgt =
            uint64_t(pc.t[2 * i]) | (uint64_t(pc.t[2 * i + 1]) << 32);
        if (hit[i] < tgt) { under = true; break; }
        if (hit[i] > tgt) { under = false; break; }
    }

    if (pc.dumpMode == 1u) {
        // Tests only: every hash, in nonce order, so the host can compare each.
        const uint slot = uint(index) * 18u;
        outbuf.v[slot + 0] = uint(nonce);
        outbuf.v[slot + 1] = uint(nonce >> 32);
        for (int i = 0; i < 8; i++) outbuf.v[slot + 2 + i] = fs[i];
        for (int i = 0; i < 8; i++) outbuf.v[slot + 10 + i] = mixHash[i];
        return;
    }
    if (!under) return;

    const uint slot = atomicAdd(cnt.n, 1u);
    if (slot >= MAX_OUT) return;
    outbuf.v[slot * 18 + 0] = uint(nonce);
    outbuf.v[slot * 18 + 1] = uint(nonce >> 32);
    for (int i = 0; i < 8; i++) outbuf.v[slot * 18 + 2 + i] = fs[i];
    for (int i = 0; i < 8; i++) outbuf.v[slot * 18 + 10 + i] = mixHash[i];
}

