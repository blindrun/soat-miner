#version 450
// KawPow's mix, as a Vulkan compute shader.
//
// A second transcription of src/algos/progpow/progpow.h and
// src/algos/kawpow/kawpow.h, which together are the one source of truth shared
// by the host and CUDA. tests/test_kawpow_vulkan hashes the same nonces here
// and on the host and requires every word to match, because a shader that has
// been compiled is not a shader that has been verified - NVIDIA's Vulkan
// compiler once miscompiled the Autolykos kernel in this repository and the
// miner mined happily while every share was silently rejected.
//
// This is the CORRECTNESS version, and it is slow on purpose
// -----------------------------------------------------------
// The program arrives in a storage buffer, so `mix[prog.mathDst[i]]` is a
// dynamic index into a local array - which is the GLSL trap that already cost
// this repository a 75x slowdown in the Blake2b kernel. The 32-word register
// file will not stay in registers here.
//
// That is a deliberate first step, not an oversight. The fast version bakes
// the same program into specialisation constants so every index is a constant
// the driver folds at pipeline-creation time, and the pipeline is rebuilt once
// per 3-block period. Measured on CUDA, the equivalent change is 11.9 -> 60.3
// MH/s. Writing the fast one first would mean debugging the translation and
// the code generation at the same time, and this file is what the fast one
// gets checked against.
//
// Lane layout: sixteen consecutive invocations are one hash, exactly as in the
// CUDA kernel. The two cross-lane steps - reading lane (r % 16)'s register 0
// each round, and the final reduction - go through shared memory rather than
// subgroup shuffles, so no subgroup extension is required. Every invocation
// must reach every barrier, which is why an out-of-range invocation is marked
// inactive rather than returning early.
//
// The Keccak-f[800] round body is GENERATED by scripts/gen_keccak800_round.py
// from the same tables the host uses. Eleven of the twenty-four rotation
// offsets change when the lane narrows from 64 bits to 32, and one left at its
// wide value produces plausible, wrong digests.

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x_id = 0) in;
layout(constant_id = 1) const uint MAX_OUT = 256;

layout(std430, binding = 0) readonly buffer Prog {
    uint cacheSrc[11];
    uint cacheDst[11];
    uint cacheSel[11];
    uint mathSrc1[18];
    uint mathSrc2[18];
    uint mathSel1[18];
    uint mathDst[18];
    uint mathSel2[18];
    uint dagDst[4];
    uint dagSel[4];
} prog;

layout(std430, binding = 1) readonly buffer Dag0 { uint w[]; } dag0;
layout(std430, binding = 2) readonly buffer Dag1 { uint w[]; } dag1;
layout(std430, binding = 3) readonly buffer Dag2 { uint w[]; } dag2;
layout(std430, binding = 4) readonly buffer Dag3 { uint w[]; } dag3;

// 18 words per solution: nonce (2), final hash (8), mix hash (8).
layout(std430, binding = 5) buffer Out { uint v[]; } outbuf;
layout(std430, binding = 6) buffer Cnt { uint n; } cnt;

layout(push_constant) uniform PC {
    uint h[8];             // header hash, little-endian words
    uint baseLo, baseHi;   // first nonce
    uint countLo, countHi; // how many nonces this dispatch owns
    uint t[8];             // 256-bit target as word pairs, t[0..1] = limb 0
    uint numItems2048;
    uint wordsPerBufShift;  // log2, so the split costs a shift and not a divide
    uint dumpMode;          // 1 = write every hash, tests only
} pc;

const uint FNV_PRIME = 0x01000193u;
const uint FNV_OFFSET = 0x811c9dc5u;
const uint L1_WORDS = 4096u;

// The Ravencoin tail. Note the first word is 0x72, lower case r: Ravencoin's
// own source writes 0x72 and comments it //R, and the constant is what
// consensus follows.
const uint RAVEN[15] = uint[15](
    0x00000072u, 0x00000041u, 0x00000056u, 0x00000045u, 0x0000004Eu,
    0x00000043u, 0x0000004Fu, 0x00000049u, 0x0000004Eu, 0x0000004Bu,
    0x00000041u, 0x00000057u, 0x00000050u, 0x0000004Fu, 0x00000057u);

const uint RC800[22] = uint[22](
    0x00000001u, 0x00008082u, 0x0000808au, 0x80008000u, 0x0000808bu,
    0x80000001u, 0x80008081u, 0x00008009u, 0x0000008au, 0x00000088u,
    0x80008009u, 0x8000000au, 0x8000808bu, 0x0000008bu, 0x00008089u,
    0x00008003u, 0x00008002u, 0x00000080u, 0x0000800au, 0x8000000au,
    0x80008081u, 0x00008080u);

// The 16 KB L1 cache, and the two cross-lane scratch slots.
shared uint l1[L1_WORDS];
shared uint xlane[1024];

uint rotl32(uint x, uint n) {
    n &= 31u;
    return n == 0u ? x : ((x << n) | (x >> (32u - n)));
}
uint rotr32(uint x, uint n) {
    n &= 31u;
    return n == 0u ? x : ((x >> n) | (x << (32u - n)));
}
uint fnv1a(uint u, uint v) { return (u ^ v) * FNV_PRIME; }
uint bswap32(uint x) {
    return ((x & 0x000000ffu) << 24) | ((x & 0x0000ff00u) << 8) |
           ((x & 0x00ff0000u) >> 8) | ((x & 0xff000000u) >> 24);
}

void keccakf800(inout uint a[25]) {
    uint bc0, bc1, bc2, bc3, bc4, t;
    for (int r = 0; r < 22; r++) {
        // Theta
        bc0 = a[0] ^ a[5] ^ a[10] ^ a[15] ^ a[20];
        bc1 = a[1] ^ a[6] ^ a[11] ^ a[16] ^ a[21];
        bc2 = a[2] ^ a[7] ^ a[12] ^ a[17] ^ a[22];
        bc3 = a[3] ^ a[8] ^ a[13] ^ a[18] ^ a[23];
        bc4 = a[4] ^ a[9] ^ a[14] ^ a[19] ^ a[24];
        t = bc4 ^ rotl32(bc1, 1);
        a[0] ^= t;
        a[5] ^= t;
        a[10] ^= t;
        a[15] ^= t;
        a[20] ^= t;
        t = bc0 ^ rotl32(bc2, 1);
        a[1] ^= t;
        a[6] ^= t;
        a[11] ^= t;
        a[16] ^= t;
        a[21] ^= t;
        t = bc1 ^ rotl32(bc3, 1);
        a[2] ^= t;
        a[7] ^= t;
        a[12] ^= t;
        a[17] ^= t;
        a[22] ^= t;
        t = bc2 ^ rotl32(bc4, 1);
        a[3] ^= t;
        a[8] ^= t;
        a[13] ^= t;
        a[18] ^= t;
        a[23] ^= t;
        t = bc3 ^ rotl32(bc0, 1);
        a[4] ^= t;
        a[9] ^= t;
        a[14] ^= t;
        a[19] ^= t;
        a[24] ^= t;

        // Rho and Pi
        t = a[1];
        bc0 = a[10];
        a[10] = rotl32(t, 1);
        t = bc0;
        bc0 = a[7];
        a[7] = rotl32(t, 3);
        t = bc0;
        bc0 = a[11];
        a[11] = rotl32(t, 6);
        t = bc0;
        bc0 = a[17];
        a[17] = rotl32(t, 10);
        t = bc0;
        bc0 = a[18];
        a[18] = rotl32(t, 15);
        t = bc0;
        bc0 = a[3];
        a[3] = rotl32(t, 21);
        t = bc0;
        bc0 = a[5];
        a[5] = rotl32(t, 28);
        t = bc0;
        bc0 = a[16];
        a[16] = rotl32(t, 4);
        t = bc0;
        bc0 = a[8];
        a[8] = rotl32(t, 13);
        t = bc0;
        bc0 = a[21];
        a[21] = rotl32(t, 23);
        t = bc0;
        bc0 = a[24];
        a[24] = rotl32(t, 2);
        t = bc0;
        bc0 = a[4];
        a[4] = rotl32(t, 14);
        t = bc0;
        bc0 = a[15];
        a[15] = rotl32(t, 27);
        t = bc0;
        bc0 = a[23];
        a[23] = rotl32(t, 9);
        t = bc0;
        bc0 = a[19];
        a[19] = rotl32(t, 24);
        t = bc0;
        bc0 = a[13];
        a[13] = rotl32(t, 8);
        t = bc0;
        bc0 = a[12];
        a[12] = rotl32(t, 25);
        t = bc0;
        bc0 = a[2];
        a[2] = rotl32(t, 11);
        t = bc0;
        bc0 = a[20];
        a[20] = rotl32(t, 30);
        t = bc0;
        bc0 = a[14];
        a[14] = rotl32(t, 18);
        t = bc0;
        bc0 = a[22];
        a[22] = rotl32(t, 7);
        t = bc0;
        bc0 = a[9];
        a[9] = rotl32(t, 29);
        t = bc0;
        bc0 = a[6];
        a[6] = rotl32(t, 20);
        t = bc0;
        bc0 = a[1];
        a[1] = rotl32(t, 12);
        t = bc0;

        // Chi
        bc0 = a[0];
        bc1 = a[1];
        bc2 = a[2];
        bc3 = a[3];
        bc4 = a[4];
        a[0] = bc0 ^ ((~bc1) & bc2);
        a[1] = bc1 ^ ((~bc2) & bc3);
        a[2] = bc2 ^ ((~bc3) & bc4);
        a[3] = bc3 ^ ((~bc4) & bc0);
        a[4] = bc4 ^ ((~bc0) & bc1);
        bc0 = a[5];
        bc1 = a[6];
        bc2 = a[7];
        bc3 = a[8];
        bc4 = a[9];
        a[5] = bc0 ^ ((~bc1) & bc2);
        a[6] = bc1 ^ ((~bc2) & bc3);
        a[7] = bc2 ^ ((~bc3) & bc4);
        a[8] = bc3 ^ ((~bc4) & bc0);
        a[9] = bc4 ^ ((~bc0) & bc1);
        bc0 = a[10];
        bc1 = a[11];
        bc2 = a[12];
        bc3 = a[13];
        bc4 = a[14];
        a[10] = bc0 ^ ((~bc1) & bc2);
        a[11] = bc1 ^ ((~bc2) & bc3);
        a[12] = bc2 ^ ((~bc3) & bc4);
        a[13] = bc3 ^ ((~bc4) & bc0);
        a[14] = bc4 ^ ((~bc0) & bc1);
        bc0 = a[15];
        bc1 = a[16];
        bc2 = a[17];
        bc3 = a[18];
        bc4 = a[19];
        a[15] = bc0 ^ ((~bc1) & bc2);
        a[16] = bc1 ^ ((~bc2) & bc3);
        a[17] = bc2 ^ ((~bc3) & bc4);
        a[18] = bc3 ^ ((~bc4) & bc0);
        a[19] = bc4 ^ ((~bc0) & bc1);
        bc0 = a[20];
        bc1 = a[21];
        bc2 = a[22];
        bc3 = a[23];
        bc4 = a[24];
        a[20] = bc0 ^ ((~bc1) & bc2);
        a[21] = bc1 ^ ((~bc2) & bc3);
        a[22] = bc2 ^ ((~bc3) & bc4);
        a[23] = bc3 ^ ((~bc4) & bc0);
        a[24] = bc4 ^ ((~bc0) & bc1);

        // Iota
        a[0] ^= RC800[r];
    }
}

/** KISS99. A single wrong constant changes every hash. */
struct Kiss { uint z, w, jsr, jcong; };

uint kissNext(inout Kiss k) {
    k.z = 36969u * (k.z & 0xffffu) + (k.z >> 16);
    k.w = 18000u * (k.w & 0xffffu) + (k.w >> 16);
    k.jcong = 69069u * k.jcong + 1234567u;
    k.jsr ^= (k.jsr << 17);
    k.jsr ^= (k.jsr >> 13);
    k.jsr ^= (k.jsr << 5);
    return (((k.z << 16) + k.w) ^ k.jcong) + k.jsr;
}

/** ProgPoW 0.9.4's eleven operations. KawPow uses this labelling; 0.9.2
 *  rotates it, which is handled on the host and does not reach this shader. */
uint randomMath(uint a, uint b, uint sel) {
    switch (sel % 11u) {
        case 0u: return a + b;
        case 1u: return a * b;
        case 2u: return uint((uint64_t(a) * uint64_t(b)) >> 32);
        case 3u: return min(a, b);
        case 4u: return rotl32(a, b);
        case 5u: return rotr32(a, b);
        case 6u: return a & b;
        case 7u: return a | b;
        case 8u: return a ^ b;
        case 9u: return uint(findMSB(a) < 0 ? 32 : 31 - findMSB(a)) +
                        uint(findMSB(b) < 0 ? 32 : 31 - findMSB(b));
        default: return uint(bitCount(a)) + uint(bitCount(b));
    }
}

/** Only operations that keep a's entropy when b has little - hence no a & b. */
void randomMerge(inout uint a, uint b, uint sel) {
    const uint x = (sel >> 16) % 31u + 1u;
    switch (sel % 4u) {
        case 0u: a = (a * 33u) + b; break;
        case 1u: a = (a ^ b) * 33u; break;
        case 2u: a = rotl32(a, x) ^ b; break;
        default: a = rotr32(a, x) ^ b; break;
    }
}

/**
 * One word out of the split DAG.
 *
 * The buffer count is a power of two words on purpose. A divide by a runtime
 * value here was the actual cost of this shader: four words per lane per
 * round, sixty-four rounds, sixteen lanes is 4096 integer divisions per hash,
 * and a GPU has no integer divide. Measured, it held the whole shader at 1.67
 * MH/s while neither specialisation constants nor removing the per-round
 * barriers moved it at all.
 */
uint dagWord(uint wordIndex) {
    const uint buf = wordIndex >> pc.wordsPerBufShift;
    const uint idx = wordIndex & ((1u << pc.wordsPerBufShift) - 1u);
    if (buf == 0u) return dag0.w[idx];
    if (buf == 1u) return dag1.w[idx];
    if (buf == 2u) return dag2.w[idx];
    return dag3.w[idx];
}

/** The four words a lane reads in a round are contiguous and, because every
 *  buffer is a multiple of 64 words, always in the same buffer - so the
 *  selection is done once rather than four times. */
void dagQuad(uint wordIndex, out uint d[4]) {
    const uint buf = wordIndex >> pc.wordsPerBufShift;
    const uint idx = wordIndex & ((1u << pc.wordsPerBufShift) - 1u);
    if (buf == 0u)      { d[0] = dag0.w[idx]; d[1] = dag0.w[idx + 1u]; d[2] = dag0.w[idx + 2u]; d[3] = dag0.w[idx + 3u]; }
    else if (buf == 1u) { d[0] = dag1.w[idx]; d[1] = dag1.w[idx + 1u]; d[2] = dag1.w[idx + 2u]; d[3] = dag1.w[idx + 3u]; }
    else if (buf == 2u) { d[0] = dag2.w[idx]; d[1] = dag2.w[idx + 1u]; d[2] = dag2.w[idx + 2u]; d[3] = dag2.w[idx + 3u]; }
    else                { d[0] = dag3.w[idx]; d[1] = dag3.w[idx + 1u]; d[2] = dag3.w[idx + 2u]; d[3] = dag3.w[idx + 3u]; }
}

void main() {
    const uint lane = gl_LocalInvocationID.x % 16u;
    const uint group = gl_LocalInvocationID.x / 16u;
    const uint groups = gl_WorkGroupSize.x / 16u;

    // The L1 cache is the first 16 KB of the DAG, copied in once per workgroup.
    for (uint i = gl_LocalInvocationID.x; i < L1_WORDS; i += gl_WorkGroupSize.x)
        l1[i] = dagWord(i);
    barrier();

    const uint64_t base = uint64_t(pc.baseLo) | (uint64_t(pc.baseHi) << 32);
    const uint64_t count = uint64_t(pc.countLo) | (uint64_t(pc.countHi) << 32);
    const uint64_t index =
        uint64_t(gl_WorkGroupID.x) * uint64_t(groups) + uint64_t(group);
    // Out-of-range invocations stay in the workgroup so every barrier below is
    // reached by everyone. Returning here would be undefined behaviour.
    const bool inRange = index < count;
    const uint64_t nonce = base + (inRange ? index : 0UL);

    uint st[25];
    for (int i = 0; i < 8; i++) st[i] = pc.h[i];
    st[8] = uint(nonce);
    st[9] = uint(nonce >> 32);
    for (int i = 10; i < 25; i++) st[i] = RAVEN[i - 10];
    keccakf800(st);
    uint state2[8];
    for (int i = 0; i < 8; i++) state2[i] = st[i];

    const uint z = fnv1a(FNV_OFFSET, state2[0]);
    const uint w = fnv1a(z, state2[1]);
    Kiss rng = Kiss(z, w, fnv1a(w, lane), fnv1a(fnv1a(w, lane), lane));
    uint mix[32];
    for (int i = 0; i < 32; i++) mix[i] = kissNext(rng);

    for (uint r = 0u; r < 64u; r++) {
        // Lane (r % 16)'s register zero, through shared memory.
        //
        // A subgroup shuffle does this without the two barriers and was tried:
        // it measured 1.67 MH/s against 1.67. It is not kept, because it would
        // add a GL_KHR_shader_subgroup_shuffle requirement to every device for
        // no measured gain, and an unused requirement is a device this miner
        // refuses to run on for nothing.
        xlane[gl_LocalInvocationID.x] = mix[0];
        barrier();
        const uint seedReg = xlane[group * 16u + (r % 16u)];
        barrier();

        const uint item = seedReg % pc.numItems2048;
        const uint chunk = (lane ^ r) % 16u;
        const uint dbase = item * 64u + chunk * 4u;
        uint d[4];
        dagQuad(dbase, d);

        for (int i = 0; i < 18; i++) {
            if (i < 11) {
                const uint off = mix[prog.cacheSrc[i]] % L1_WORDS;
                randomMerge(mix[prog.cacheDst[i]], l1[off], prog.cacheSel[i]);
            }
            const uint t = randomMath(mix[prog.mathSrc1[i]],
                                      mix[prog.mathSrc2[i]], prog.mathSel1[i]);
            randomMerge(mix[prog.mathDst[i]], t, prog.mathSel2[i]);
        }
        for (int i = 0; i < 4; i++)
            randomMerge(mix[prog.dagDst[i]], d[i], prog.dagSel[i]);
    }

    uint lh = FNV_OFFSET;
    for (int i = 0; i < 32; i++) lh = fnv1a(lh, mix[i]);
    xlane[gl_LocalInvocationID.x] = lh;
    barrier();

    if (lane != 0u || !inRange) return;

    uint mixHash[8];
    for (int i = 0; i < 8; i++) mixHash[i] = FNV_OFFSET;
    for (uint l = 0u; l < 16u; l++)
        mixHash[l % 8u] = fnv1a(mixHash[l % 8u], xlane[group * 16u + l]);

    uint fs[25];
    for (int i = 0; i < 8; i++) fs[i] = state2[i];
    for (int i = 0; i < 8; i++) fs[8 + i] = mixHash[i];
    for (int i = 16; i < 25; i++) fs[i] = RAVEN[i - 16];
    keccakf800(fs);

    // The digest is a BIG-endian 256-bit integer: byte 0 is most significant.
    uint64_t hit[4];
    for (int k = 0; k < 4; k++)
        hit[3 - k] = (uint64_t(bswap32(fs[2 * k])) << 32) |
                     uint64_t(bswap32(fs[2 * k + 1]));

    bool under = true;
    for (int i = 3; i >= 0; i--) {
        const uint64_t tgt =
            uint64_t(pc.t[2 * i]) | (uint64_t(pc.t[2 * i + 1]) << 32);
        if (hit[i] < tgt) { under = true; break; }
        if (hit[i] > tgt) { under = false; break; }
    }

    if (pc.dumpMode == 1u) {
        // Tests only: every hash, in nonce order, so the host can compare each.
        const uint slot = uint(index) * 18u;
        outbuf.v[slot + 0] = uint(nonce);
        outbuf.v[slot + 1] = uint(nonce >> 32);
        for (int i = 0; i < 8; i++) outbuf.v[slot + 2 + i] = fs[i];
        for (int i = 0; i < 8; i++) outbuf.v[slot + 10 + i] = mixHash[i];
        return;
    }
    if (!under) return;

    const uint slot = atomicAdd(cnt.n, 1u);
    if (slot >= MAX_OUT) return;
    outbuf.v[slot * 18 + 0] = uint(nonce);
    outbuf.v[slot * 18 + 1] = uint(nonce >> 32);
    for (int i = 0; i < 8; i++) outbuf.v[slot * 18 + 2 + i] = fs[i];
    for (int i = 0; i < 8; i++) outbuf.v[slot * 18 + 10 + i] = mixHash[i];
}
