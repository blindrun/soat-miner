# build-binary variants and experiment scratch binaries (never commit these)
soat-miner-*
sm-*
build13
soat-miner-13

scratchpad/
tools/__pycache__/

# Compiled binaries in tests/. Matches on the ABSENCE of an extension rather
# than on a name prefix, because the prefix version was still a list in
# disguise: it covered tests/test_* and then bench_compile_latency appeared and
# was not covered. Sources and scripts all carry an extension, so un-ignoring
# anything with a dot keeps them tracked, and !tests/*/ keeps subdirectories.
tests/*
!tests/*.*
!tests/*/
# Re-ignored: the un-ignore above brings subdirectories back, including this
# one, which an earlier explicit rule had covered.
tests/__pycache__/
