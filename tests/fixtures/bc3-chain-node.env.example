# Placeholder only. It is deliberately unusable until an owner supplies every
# value out of band and expressly approves a chain-only fixture capture.
# Do not put credentials, cookies, wallet paths, addresses, or live endpoints
# in this file or commit a filled-in copy.

# Selected safe configuration: a named, disposable local regtest node only.
# Testnet is not an equivalent default because it has external peers.
BC3_CHAIN_NODE_NETWORK=regtest

# Owner-supplied identity, such as the approved host and service/container
# name. It must not be an inferred localhost listener.
BC3_CHAIN_NODE_ID=

# An explicitly approved loopback/private RPC endpoint, not a public address.
BC3_CHAIN_NODE_RPC_URL=

# The exact daemon version and the owner-confirmed option/launch argument that
# disables wallet RPC. This is evidence, not an instruction to change a node.
BC3_CHAIN_NODE_VERSION=
BC3_CHAIN_NODE_WALLET_RPC_DISABLED_PROOF=

# Out-of-band, least-privilege read-only authentication reference. Leave blank
# in the repository. Never use a wallet cookie or wallet-scoped RPC endpoint.
BC3_CHAIN_NODE_READONLY_AUTH_REFERENCE=

# Fixed allowlist for a future capture script; no other RPC calls are allowed.
BC3_CHAIN_NODE_ALLOWED_METHODS=getblockchaininfo,getblocktemplate

# Optional destination schema for a future sanitized fixture. Exactly one is
# allowed and neither is resolved by this repository:
# BC3_SWEEP_DESTINATION=address:<BC3 payout address>
# BC3_SWEEP_DESTINATION=secret-ref:crypto-recovery/<control-record>
